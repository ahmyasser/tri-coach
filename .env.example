# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32

# Public hostname pointing at this server (HTTPS certificate, sign-in links, Google callback, MCP)
PUBLIC_HOST=coach.example.com
BRAND_NAME=Tri Coach

POSTGRES_PASSWORD=change-me
# Signs session cookies
SECRET_KEY=change-me
# Encrypts Garmin tokens at rest:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=change-me
# Who gets the /admin page (comma-separated); also the contact address on the legal pages unless CONTACT_EMAIL is set
ADMIN_EMAILS=you@example.com
CONTACT_EMAIL=
# Beta: new accounts need an invite code
INVITE_ONLY=1

# Sign-in with Google (Google Cloud > APIs & Services > Credentials > OAuth client, type "Web application",
# redirect URI https://PUBLIC_HOST/auth/google/callback). Leave empty to offer email links only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email sign-in links via Resend (resend.com). Without these, links are only written to the log / admin page.
RESEND_API_KEY=
EMAIL_FROM=Tri Coach <hello@example.com>

# AI coach (Anthropic API). Free and Pro differ in model and daily spend cap per user, in USD.
ANTHROPIC_API_KEY=
FREE_MODEL=claude-sonnet-5-5
FREE_DAILY_USD=0.10
PRO_MODEL=claude-opus-5-5
PRO_DAILY_USD=0.50
COACH_DAILY_BRIEFING=1

# Daily sync time and timezone
TZ=Africa/Cairo
SYNC_TIME=05:30

# Optional tuning
WELLNESS_BACKFILL_DAYS=400
RESYNC_DAYS=3
GARMIN_REQUEST_PAUSE_MS=400
LOG_LEVEL=INFO
