# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 24

# Domain pointing at this server (needed for HTTPS and for Claude to reach the MCP endpoint)
PUBLIC_HOST=coach.example.com

POSTGRES_PASSWORD=change-me

# Dashboard login (HTTP basic auth)
DASHBOARD_USER=ahmed
DASHBOARD_PASSWORD=change-me

# Secret part of the MCP URL: https://PUBLIC_HOST/mcp/<MCP_TOKEN>
MCP_TOKEN=change-me

# Secret for the "sync now" webhook: https://PUBLIC_HOST/api/sync?token=<SYNC_WEBHOOK_TOKEN>
SYNC_WEBHOOK_TOKEN=change-me

# Daily sync time and timezone
TZ=Africa/Cairo
SYNC_TIME=05:30

# Optional tuning
WELLNESS_BACKFILL_DAYS=400
RESYNC_DAYS=3
GARMIN_REQUEST_PAUSE_MS=400
LOG_LEVEL=INFO
