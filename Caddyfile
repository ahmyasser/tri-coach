# HTTPS (automatic Let's Encrypt certificate) in front of the app.
# Point a DNS A record for PUBLIC_HOST at the server before starting.
{$PUBLIC_HOST} {
	encode gzip
	reverse_proxy app:8000
}

# More instances on the same server (e.g. a friend's): one file per site in ./sites, see sites/README.md
import /etc/caddy/sites/*.caddy
